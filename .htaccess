# Defense in depth for XAMPP installs. Production DocumentRoot must still be /public.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\. - [F,L]
    # Keep retired private paths blocked on upgraded installations.
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|vendor|node_modules|dev|tests|whatsapp-gateway)(/|$) - [F,L,NC]
    RewriteRule ^[^/]+\.(php|sql|gz|json|lock|md|py|js|xml|txt)$ - [F,L,NC]
</IfModule>
